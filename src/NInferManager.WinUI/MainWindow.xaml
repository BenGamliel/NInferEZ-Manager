<Window
    x:Class="NInferManager.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="NInferEZ Manager">

    <Grid x:Name="Root" Background="{ThemeResource PageBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="236" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border x:Name="Sidebar" Grid.Column="0" Background="{ThemeResource NavigationBrush}" BorderBrush="{ThemeResource BorderSoftBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid x:Name="SidebarHeader" Height="64" Margin="8,8,8,18" BorderBrush="{ThemeResource BorderSoftBrush}" BorderThickness="0,0,0,1">
                    <StackPanel x:Name="SidebarBrandExpanded" Margin="10,0,48,0" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Border Width="36" Height="36" CornerRadius="11" Background="{ThemeResource AccentBrush}">
                            <Grid Width="19" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" ColumnSpacing="3">
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <Border Height="10" VerticalAlignment="Bottom" CornerRadius="2" Background="#FF071410" />
                                <Border Grid.Column="1" Height="18" VerticalAlignment="Bottom" CornerRadius="2" Background="#FF071410" />
                                <Border Grid.Column="2" Height="13" VerticalAlignment="Bottom" CornerRadius="2" Background="#FF071410" />
                            </Grid>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="0">
                            <TextBlock Text="NInferEZ" FontFamily="Segoe UI Variable Display" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="MANAGER" Style="{StaticResource CaptionStyle}" FontSize="9" CharacterSpacing="170" />
                        </StackPanel>
                    </StackPanel>
                    <Border x:Name="SidebarBrandCompact" Width="36" Height="36" Margin="0,8,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="Collapsed" CornerRadius="11" Background="{ThemeResource AccentBrush}">
                        <Grid Width="19" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" ColumnSpacing="3">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <Border Height="10" VerticalAlignment="Bottom" CornerRadius="2" Background="#FF071410" />
                            <Border Grid.Column="1" Height="18" VerticalAlignment="Bottom" CornerRadius="2" Background="#FF071410" />
                            <Border Grid.Column="2" Height="13" VerticalAlignment="Bottom" CornerRadius="2" Background="#FF071410" />
                        </Grid>
                    </Border>
                    <Button x:Name="PaneToggleButton" Width="36" Height="36" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Center" Background="{ThemeResource SurfaceBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="10" Click="PaneToggle_Click">
                        <Grid Width="18" Height="16">
                            <Border BorderBrush="{ThemeResource TextFillColorPrimaryBrush}" BorderThickness="1.4" CornerRadius="3" />
                            <Border Width="1" Height="12" Margin="6,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{ThemeResource TextFillColorPrimaryBrush}" Opacity="0.7" />
                            <FontIcon x:Name="PaneToggleDirectionGlyph" Margin="7,0,0,0" Glyph="&#xE76B;" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                </Grid>

                <StackPanel x:Name="SidebarMenu" Grid.Row="1">
                    <Button x:Name="DashboardNavButton" Tag="dashboard" Click="SidebarNav_Click" Style="{StaticResource SidebarNavButtonStyle}" ToolTipService.ToolTip="Overview"><StackPanel Orientation="Horizontal" Spacing="14"><FontIcon Glyph="&#xE80F;" Width="20" /><TextBlock x:Name="DashboardNavLabel" Text="Overview" VerticalAlignment="Center" /></StackPanel></Button>
                    <Button x:Name="ModelsNavButton" Tag="models" Click="SidebarNav_Click" Style="{StaticResource SidebarNavButtonStyle}" ToolTipService.ToolTip="Models"><StackPanel Orientation="Horizontal" Spacing="14"><FontIcon Glyph="&#xE8B7;" Width="20" /><TextBlock x:Name="ModelsNavLabel" Text="Models" VerticalAlignment="Center" /></StackPanel></Button>
                    <Button x:Name="RequestsNavButton" Tag="requests" Click="SidebarNav_Click" Style="{StaticResource SidebarNavButtonStyle}" ToolTipService.ToolTip="Requests"><StackPanel Orientation="Horizontal" Spacing="14"><FontIcon Glyph="&#xE9D2;" Width="20" /><TextBlock x:Name="RequestsNavLabel" Text="Requests" VerticalAlignment="Center" /></StackPanel></Button>
                    <Button x:Name="LogsNavButton" Tag="logs" Click="SidebarNav_Click" Style="{StaticResource SidebarNavButtonStyle}" ToolTipService.ToolTip="Logs"><StackPanel Orientation="Horizontal" Spacing="14"><FontIcon Glyph="&#xE9D5;" Width="20" /><TextBlock x:Name="LogsNavLabel" Text="Logs" VerticalAlignment="Center" /></StackPanel></Button>
                    <Button x:Name="EngineNavButton" Tag="engine" Click="SidebarNav_Click" Style="{StaticResource SidebarNavButtonStyle}" ToolTipService.ToolTip="Engine"><StackPanel Orientation="Horizontal" Spacing="14"><FontIcon Glyph="&#xE950;" Width="20" /><TextBlock x:Name="EngineNavLabel" Text="Engine" VerticalAlignment="Center" /></StackPanel></Button>
                    <Button x:Name="SettingsNavButton" Tag="settings" Click="SidebarNav_Click" Style="{StaticResource SidebarNavButtonStyle}" ToolTipService.ToolTip="Settings"><StackPanel Orientation="Horizontal" Spacing="14"><FontIcon Glyph="&#xE713;" Width="20" /><TextBlock x:Name="SettingsNavLabel" Text="Settings" VerticalAlignment="Center" /></StackPanel></Button>
                </StackPanel>

                <Grid Grid.Row="3" Margin="8,0,8,8">
                    <StackPanel x:Name="PaneFooterExpanded" Spacing="12">
                        <Border Style="{StaticResource CompactCardStyle}" Padding="12">
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="8"><Ellipse Width="7" Height="7" Fill="{ThemeResource SuccessBrush}" VerticalAlignment="Center" /><TextBlock x:Name="SidebarGpuName" Text="Detecting GPU" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /></StackPanel>
                                <ProgressBar x:Name="SidebarVramBar" Height="4" Minimum="0" Maximum="100" Value="0" />
                                <TextBlock x:Name="SidebarVramText" Text="VRAM information unavailable" Style="{StaticResource CaptionStyle}" FontSize="9" />
                            </StackPanel>
                        </Border>
                        <Grid Margin="6,0" ColumnSpacing="7" HorizontalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="32" Height="32" CornerRadius="10" Background="{ThemeResource AccentSoftBrush}">
                                <TextBlock Text="NE" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10.5" FontWeight="SemiBold" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Local workspace" FontSize="10.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="NInferEZ Manager" Style="{StaticResource CaptionStyle}" FontSize="8.5" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel x:Name="SidebarPublisherSignature" Grid.Column="2" Orientation="Horizontal" Spacing="3" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTipService.ToolTip="Created by 2beng2">
                                <TextBlock Text="By" Style="{StaticResource CaptionStyle}" FontSize="8" VerticalAlignment="Center" />
                                <Image x:Name="SidebarPublisherLogo" Width="54" Height="27" Stretch="Uniform" AutomationProperties.Name="2beng2" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                    <Border x:Name="PaneFooterCompact" Width="44" Height="44" HorizontalAlignment="Center" VerticalAlignment="Bottom" Visibility="Collapsed" CornerRadius="12" Background="{ThemeResource SurfaceBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1">
                        <Grid><FontIcon Glyph="&#xE950;" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" /><Ellipse Width="8" Height="8" Margin="0,8,8,0" Fill="{ThemeResource SuccessBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" /></Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>

            <Grid Grid.Column="1" Background="{ThemeResource PageBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="64" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Padding="28,0" BorderBrush="{ThemeResource BorderSoftBrush}" BorderThickness="0,0,0,1" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                        <TextBlock Text="NInferEZ Manager" Style="{StaticResource CaptionStyle}" FontSize="12" />
                        <TextBlock Text="/" Foreground="{ThemeResource BorderBrush}" />
                        <TextBlock x:Name="TopPageTitle" Text="Overview" FontWeight="SemiBold" />
                    </StackPanel>
                    <Border Grid.Column="1" Padding="11,6" CornerRadius="9" Background="{ThemeResource SurfaceBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse Width="7" Height="7" Fill="{ThemeResource SuccessBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="API ready" Style="{StaticResource CaptionStyle}" FontSize="10" VerticalAlignment="Center" />
                            <TextBlock x:Name="TopEndpoint" Text=":8173" Foreground="{ThemeResource AccentBrush}" FontSize="10" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Button Grid.Column="2" Click="CopyEndpoint_Click" Style="{StaticResource ManagerPrimaryButtonStyle}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon Glyph="&#xE8C8;" FontSize="13" />
                            <TextBlock Text="Copy endpoint" />
                        </StackPanel>
                    </Button>
                </Grid>

                <InfoBar x:Name="GlobalInfo" Grid.Row="1" Margin="24,12,24,0" IsOpen="False" IsClosable="True" />

                <Grid Grid.Row="2">
                    <ScrollViewer x:Name="DashboardPage">
                        <StackPanel Padding="34,30,34,60" Spacing="15" MaxWidth="1420" HorizontalAlignment="Stretch">
                            <Grid x:Name="HeroGrid" ColumnSpacing="24" RowSpacing="18" Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Spacing="5">
                                    <TextBlock Text="LOCAL INFERENCE" Style="{StaticResource EyebrowStyle}" />
                                    <TextBlock x:Name="EngineHeadline" Text="Everything is ready." Style="{StaticResource PageTitleStyle}" TextWrapping="Wrap" />
                                    <TextBlock Text="The API is listening. Your selected model loads automatically when it is needed." Style="{StaticResource MutedStyle}" />
                                </StackPanel>
                                <StackPanel x:Name="EngineActions" Grid.Column="1" Orientation="Horizontal" Spacing="9" VerticalAlignment="Bottom">
                                    <Button x:Name="EngineMoreButton" Content="•••" Visibility="Collapsed">
                                        <Button.Flyout><MenuFlyout><MenuFlyoutItem Text="Restart engine" Click="Restart_Click" /></MenuFlyout></Button.Flyout>
                                    </Button>
                                    <Button x:Name="EnginePrimaryButton" Content="Load model" Click="EnginePrimary_Click" Style="{StaticResource ManagerPrimaryButtonStyle}" />
                                </StackPanel>
                            </Grid>

                            <Border Background="{ThemeResource AccentSoftBrush}" BorderBrush="{ThemeResource AccentBrush}" BorderThickness="1" CornerRadius="14" Padding="17,13">
                                <Grid ColumnSpacing="13">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32" CornerRadius="10" Background="{ThemeResource SurfaceAltBrush}">
                                        <Ellipse Width="9" Height="9" Fill="{ThemeResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="API online · model available on demand" FontSize="12" FontWeight="SemiBold" />
                                        <TextBlock Text="No model memory is reserved while the engine is unloaded." Style="{StaticResource CaptionStyle}" />
                                    </StackPanel>
                                    <Border Grid.Column="2" Style="{StaticResource PillStyle}" VerticalAlignment="Center">
                                        <TextBlock x:Name="EngineBadge" Text="UNLOADED" Foreground="{ThemeResource AccentBrush}" FontSize="9" FontWeight="SemiBold" />
                                    </Border>
                                </Grid>
                            </Border>

                            <Grid ColumnSpacing="15" RowSpacing="15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="0.8*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource CardStyle}" MinHeight="242">
                                    <StackPanel Spacing="18">
                                        <Grid>
                                            <TextBlock Text="ACTIVE MODEL" Style="{StaticResource CaptionStyle}" FontSize="9" CharacterSpacing="100" />
                                            <Button HorizontalAlignment="Right" Content="Manage" Click="GoToModels_Click" Foreground="{ThemeResource AccentBrush}" Background="Transparent" BorderThickness="0" />
                                        </Grid>
                                        <Grid ColumnSpacing="13">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="44" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="42" Height="42" CornerRadius="12" Background="{ThemeResource AccentSoftBrush}" BorderBrush="{ThemeResource AccentBrush}" BorderThickness="1">
                                                <TextBlock Text="Q" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource AccentBrush}" FontSize="17" FontWeight="Bold" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                                <TextBlock x:Name="ActiveModelText" Text="Choose an installed model" Style="{StaticResource CardTitleStyle}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock x:Name="ActiveModelMeta" Text="No artifact selected" Style="{StaticResource CaptionStyle}" />
                                            </StackPanel>
                                        </Grid>
                                        <Grid ColumnSpacing="26" RowSpacing="13">
                                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                            <StackPanel Spacing="3"><TextBlock Text="API NAME" Style="{StaticResource CaptionStyle}" FontSize="9" /><TextBlock x:Name="ActiveModelApiName" Text="—" FontSize="11" TextTrimming="CharacterEllipsis" /></StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="PROFILE" Style="{StaticResource CaptionStyle}" FontSize="9" /><TextBlock x:Name="ActiveProfileText" Text="Recommended" FontSize="11" /></StackPanel>
                                            <StackPanel Grid.Row="1" Spacing="3"><TextBlock Text="UNLOAD POLICY" Style="{StaticResource CaptionStyle}" FontSize="9" /><TextBlock x:Name="UnloadPolicyText" Text="After 3 minutes idle" FontSize="11" /></StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="3"><TextBlock Text="ENGINE" Style="{StaticResource CaptionStyle}" FontSize="9" /><TextBlock Text="NInferEZ Engine" FontSize="11" /></StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Style="{StaticResource CardStyle}" MinHeight="242">
                                    <StackPanel Spacing="17">
                                        <Grid>
                                            <TextBlock Text="GPU &amp; MEMORY" Style="{StaticResource CaptionStyle}" FontSize="9" CharacterSpacing="100" />
                                            <TextBlock Text="LIVE · 2s" HorizontalAlignment="Right" Foreground="{ThemeResource AccentBrush}" FontSize="9" />
                                        </Grid>
                                        <StackPanel Spacing="5">
                                            <TextBlock x:Name="GpuName" Text="Waiting for GPU" Style="{StaticResource CardTitleStyle}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock x:Name="VramValue" Text="VRAM status unavailable" Style="{StaticResource MutedStyle}" FontSize="12" />
                                        </StackPanel>
                                        <ProgressBar x:Name="VramRing" Height="8" Minimum="0" Maximum="100" Value="0" />
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                            <StackPanel><TextBlock Text="UTILIZATION" Style="{StaticResource CaptionStyle}" FontSize="9" /><TextBlock x:Name="GpuUtilizationText" Text="—" Style="{StaticResource MetricValueStyle}" FontSize="18" /></StackPanel>
                                            <StackPanel Grid.Column="1"><TextBlock Text="VRAM USED" Style="{StaticResource CaptionStyle}" FontSize="9" /><TextBlock x:Name="VramPercent" Text="0%" Style="{StaticResource MetricValueStyle}" FontSize="18" /></StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Grid x:Name="MetricCards" ColumnSpacing="15" RowSpacing="15">
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Border x:Name="VramCard" Style="{StaticResource CompactCardStyle}">
                                    <StackPanel Spacing="8"><TextBlock Text="MODEL STATUS" Style="{StaticResource CaptionStyle}" FontSize="9" CharacterSpacing="90" /><TextBlock Text="Ready for requests" Style="{StaticResource CardTitleStyle}" /><TextBlock Text="The local API can cold-load the selected model on first use." Style="{StaticResource CaptionStyle}" /></StackPanel>
                                </Border>
                                <Border x:Name="ContextCard" Grid.Column="1" Style="{StaticResource CompactCardStyle}">
                                    <StackPanel Spacing="6"><Grid><TextBlock Text="CONTEXT" Style="{StaticResource CaptionStyle}" FontSize="9" CharacterSpacing="90" /><TextBlock x:Name="ContextRingText" Text="—" HorizontalAlignment="Right" Style="{StaticResource MetricValueStyle}" /></Grid><TextBlock x:Name="ContextValue" Text="Choose a model" Style="{StaticResource MutedStyle}" FontSize="11" /><TextBlock x:Name="KvValue" Text="KV profile unavailable" Style="{StaticResource CaptionStyle}" /></StackPanel>
                                </Border>
                                <Border x:Name="SpeedCard" Grid.Column="2" Style="{StaticResource CompactCardStyle}">
                                    <StackPanel Spacing="6"><Grid><TextBlock Text="DECODE" Style="{StaticResource CaptionStyle}" FontSize="9" CharacterSpacing="90" /><TextBlock x:Name="SpeedRingText" Text="—" HorizontalAlignment="Right" Style="{StaticResource MetricValueStyle}" /></Grid><ProgressBar x:Name="SpeedRing" Height="5" Minimum="0" Maximum="100" Value="0" /><TextBlock x:Name="SpeedValue" Text="No completed requests" Style="{StaticResource CaptionStyle}" /></StackPanel>
                                </Border>
                            </Grid>

                            <Border Style="{StaticResource CompactCardStyle}">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="5">
                                        <TextBlock Text="API connection" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock Text="Use this address in any OpenAI-compatible client." Style="{StaticResource CaptionStyle}" />
                                        <TextBox x:Name="EndpointBox" Text="http://127.0.0.1:8173/v1" IsReadOnly="True" Margin="0,7,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Copy" Click="CopyEndpoint_Click" VerticalAlignment="Bottom" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="ModelsPage" Visibility="Collapsed">
                        <StackPanel Padding="34,30,34,60" Spacing="15" MaxWidth="1420" HorizontalAlignment="Stretch">
                            <Grid x:Name="ModelsHeader" ColumnSpacing="10" RowSpacing="10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                <StackPanel Spacing="5">
                                    <TextBlock Text="MODEL LIBRARY" Style="{StaticResource EyebrowStyle}" />
                                    <TextBlock Text="Models" Style="{StaticResource PageTitleStyle}" />
                                    <TextBlock Text="Local artifacts and linked files are discovered without loading GPU memory." Style="{StaticResource MutedStyle}" />
                                </StackPanel>
                                <Button x:Name="AddModelButton" Grid.Column="1" Content="Link a model" Click="AddModel_Click" Style="{StaticResource ManagerPrimaryButtonStyle}" VerticalAlignment="Bottom" />
                                <Button x:Name="RefreshModelsButton" Grid.Column="2" Content="Refresh" Click="RefreshModels_Click" VerticalAlignment="Bottom" />
                            </Grid>
                            <InfoBar x:Name="ModelsInfo" IsOpen="False" IsClosable="True" />
                            <Border x:Name="ModelsEmptyState" Style="{StaticResource CardStyle}" Visibility="Collapsed" Padding="28">
                                <StackPanel HorizontalAlignment="Center" Spacing="9" MaxWidth="520">
                                    <TextBlock Text="No models linked yet" Style="{StaticResource SectionTitleStyle}" HorizontalAlignment="Center" />
                                    <TextBlock Text="Put a .ninfer file in the Models folder and refresh, or link a file stored anywhere on this computer." Style="{StaticResource MutedStyle}" TextAlignment="Center" TextWrapping="Wrap" />
                                    <Button Content="Link your first model" Click="AddModel_Click" Style="{StaticResource ManagerPrimaryButtonStyle}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <ListView x:Name="ModelsList" ItemsSource="{x:Bind Models}" SelectionMode="None" IsItemClickEnabled="False">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,0,0,9" /></Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource CardStyle}" Padding="18">
                                            <Grid ColumnSpacing="16" RowSpacing="13">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="46" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <Border Width="42" Height="42" CornerRadius="12" Background="{ThemeResource AccentSoftBrush}" BorderBrush="{ThemeResource AccentBrush}" BorderThickness="1">
                                                    <TextBlock Text="N" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource AccentBrush}" FontWeight="Bold" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Spacing="4">
                                                    <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{Binding DisplayName}" Style="{StaticResource CardTitleStyle}" TextTrimming="CharacterEllipsis" /><Border Style="{StaticResource PillStyle}"><TextBlock Text="{Binding StateLabel}" FontSize="9" FontWeight="SemiBold" /></Border></StackPanel>
                                                    <TextBlock Text="{Binding Repository}" Style="{StaticResource CaptionStyle}" />
                                                    <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="{Binding Weights}" Style="{StaticResource CaptionStyle}" /><TextBlock Text="{Binding SizeText}" Style="{StaticResource CaptionStyle}" /><TextBlock Text="VISION" Foreground="{ThemeResource AccentBrush}" FontSize="10" Visibility="{Binding VisionVisibility}" /></StackPanel>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                                    <Button Content="Use" Click="Activate_Click" Tag="{Binding FileName}" Visibility="{Binding ActivateVisibility}" Style="{StaticResource ManagerPrimaryButtonStyle}" />
                                                    <Button Content="•••">
                                                        <Button.Flyout>
                                                            <MenuFlyout>
                                                                <MenuFlyoutItem Text="Verify integrity" Click="Verify_Click" Tag="{Binding FileName}" />
                                                                <MenuFlyoutItem Text="Remove from manager" Click="Delete_Click" Tag="{Binding FileName}" />
                                                            </MenuFlyout>
                                                        </Button.Flyout>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <Border Height="1" Background="{ThemeResource BorderSoftBrush}" Margin="0,8" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="4"><TextBlock Text="RECOMMENDED" Style="{StaticResource EyebrowStyle}" /><TextBlock Text="Ready-to-use NInfer models" Style="{StaticResource SectionTitleStyle}" /><TextBlock Text="Profiles are selected automatically for your model, engine and available VRAM." Style="{StaticResource MutedStyle}" /></StackPanel>
                                <Button Grid.Column="1" Content="Check for new models" Click="RefreshModels_Click" VerticalAlignment="Bottom" />
                            </Grid>
                            <ListView ItemsSource="{x:Bind RecommendedModels}" SelectionMode="None" IsItemClickEnabled="False">
                                <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,0,0,9" /></Style></ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource CardStyle}" Padding="18">
                                            <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <StackPanel Spacing="5"><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{Binding DisplayName}" Style="{StaticResource CardTitleStyle}" /><Border Style="{StaticResource PillStyle}" Visibility="{Binding NewVisibility}"><TextBlock Text="NEW" Foreground="{ThemeResource AccentBrush}" FontSize="9" FontWeight="SemiBold" /></Border><Border Style="{StaticResource PillStyle}" Visibility="{Binding InstalledVisibility}"><TextBlock Text="INSTALLED" FontSize="9" /></Border></StackPanel><TextBlock Text="{Binding Weights}" Style="{StaticResource CaptionStyle}" /><TextBlock Text="{Binding SizeText}" Style="{StaticResource CaptionStyle}" /></StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Button Content="View on Hugging Face" Click="OpenModelCard_Click" Tag="{Binding ModelCardUrl}" /><Button Content="Download" Click="DownloadModel_Click" Tag="{Binding FileName}" Visibility="{Binding DownloadVisibility}" Style="{StaticResource ManagerPrimaryButtonStyle}" /></StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <Border x:Name="ModelDownloadPanel" Style="{StaticResource CardStyle}" Visibility="Collapsed"><StackPanel Spacing="7"><ProgressBar x:Name="ModelDownloadProgressBar" Minimum="0" Maximum="100" /><Grid><TextBlock x:Name="ModelDownloadProgressText" Style="{StaticResource CaptionStyle}" /><Button Content="Pause" Click="CancelModelDownload_Click" HorizontalAlignment="Right" /></Grid></StackPanel></Border>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="RequestsPage" Visibility="Collapsed">
                        <StackPanel Padding="34,30,34,60" Spacing="15" MaxWidth="1420" HorizontalAlignment="Stretch">
                            <Grid ColumnSpacing="15">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="5"><TextBlock Text="OBSERVABILITY" Style="{StaticResource EyebrowStyle}" /><TextBlock Text="Requests" Style="{StaticResource PageTitleStyle}" /><TextBlock Text="Performance metadata only. Prompt and response content is not retained." Style="{StaticResource MutedStyle}" /></StackPanel>
                                <Button Grid.Column="1" Content="Refresh" Click="RefreshLogs_Click" VerticalAlignment="Bottom" />
                            </Grid>
                            <Grid x:Name="LogSummary" ColumnSpacing="12" RowSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                <Border x:Name="CompletedCard" Style="{StaticResource CompactCardStyle}"><StackPanel Spacing="4"><TextBlock Text="COMPLETED" Style="{StaticResource CaptionStyle}" FontSize="9" CharacterSpacing="90" /><TextBlock x:Name="CompletedValue" Text="0" Style="{StaticResource MetricValueStyle}" /></StackPanel></Border>
                                <Border x:Name="AverageCard" Grid.Column="1" Style="{StaticResource CompactCardStyle}"><StackPanel Spacing="4"><TextBlock Text="AVG DECODE" Style="{StaticResource CaptionStyle}" FontSize="9" CharacterSpacing="90" /><TextBlock x:Name="AverageValue" Text="—" Style="{StaticResource MetricValueStyle}" /></StackPanel></Border>
                                <Border x:Name="TtftCard" Grid.Column="2" Style="{StaticResource CompactCardStyle}"><StackPanel Spacing="4"><TextBlock Text="AVG TTFT" Style="{StaticResource CaptionStyle}" FontSize="9" CharacterSpacing="90" /><TextBlock x:Name="TtftValue" Text="—" Style="{StaticResource MetricValueStyle}" /></StackPanel></Border>
                                <Border x:Name="TokensCard" Grid.Column="3" Style="{StaticResource CompactCardStyle}"><StackPanel Spacing="4"><TextBlock Text="OUTPUT TOKENS" Style="{StaticResource CaptionStyle}" FontSize="9" CharacterSpacing="90" /><TextBlock x:Name="TotalTokensValue" Text="0" Style="{StaticResource MetricValueStyle}" /></StackPanel></Border>
                            </Grid>
                            <Border Style="{StaticResource CardStyle}" Padding="0" Clip="{x:Null}">
                                <StackPanel>
                                    <Grid Padding="17,12" Background="{ThemeResource SurfaceAltBrush}" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="100" /><ColumnDefinition Width="100" /><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /><ColumnDefinition Width="90" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="STARTED" Style="{StaticResource CaptionStyle}" FontSize="9" /><TextBlock Grid.Column="1" Text="STATUS" Style="{StaticResource CaptionStyle}" FontSize="9" /><TextBlock Grid.Column="2" Text="TYPE" Style="{StaticResource CaptionStyle}" FontSize="9" /><TextBlock Grid.Column="3" Text="TOKENS" Style="{StaticResource CaptionStyle}" FontSize="9" /><TextBlock Grid.Column="4" Text="TTFT" Style="{StaticResource CaptionStyle}" FontSize="9" /><TextBlock Grid.Column="5" Text="PREFILL" Style="{StaticResource CaptionStyle}" FontSize="9" /><TextBlock Grid.Column="6" Text="DECODE" Style="{StaticResource CaptionStyle}" FontSize="9" />
                                    </Grid>
                                    <ListView x:Name="RequestsList" ItemsSource="{x:Bind Requests}" SelectionMode="None" MaxHeight="520">
                                        <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /></Style></ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Padding="17,12" ColumnSpacing="12" BorderBrush="{ThemeResource BorderSoftBrush}" BorderThickness="0,0,0,1">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="100" /><ColumnDefinition Width="100" /><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /><ColumnDefinition Width="90" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Time}" FontSize="11" /><TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="{ThemeResource AccentBrush}" FontSize="11" /><TextBlock Grid.Column="2" Text="{Binding Type}" FontSize="11" /><TextBlock Grid.Column="3" FontSize="11"><Run Text="{Binding Input}" /><Run Text=" → " /><Run Text="{Binding Output}" /></TextBlock><TextBlock Grid.Column="4" Text="{Binding Ttft}" FontSize="11" /><TextBlock Grid.Column="5" Text="{Binding Prefill}" FontSize="11" /><TextBlock Grid.Column="6" Text="{Binding Decode}" FontSize="11" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid x:Name="LogsPage" Visibility="Collapsed" Padding="34,30,34,34">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="15" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="5"><TextBlock Text="DIAGNOSTICS" Style="{StaticResource EyebrowStyle}" /><TextBlock Text="Live logs" Style="{StaticResource PageTitleStyle}" /><TextBlock Text="Manager, API and engine events in one searchable workspace." Style="{StaticResource MutedStyle}" /></StackPanel>
                            <Button Grid.Column="1" Content="Open log folder" Click="OpenLog_Click" VerticalAlignment="Bottom" />
                            <Button Grid.Column="2" Content="Export diagnostics" Click="Diagnostics_Click" Style="{StaticResource ManagerPrimaryButtonStyle}" VerticalAlignment="Bottom" />
                        </Grid>
                        <Border Grid.Row="2" Background="{ThemeResource LogBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="15">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="50" /><RowDefinition Height="*" /><RowDefinition Height="34" /></Grid.RowDefinitions>
                                <Grid Padding="12,0" Background="{ThemeResource SurfaceBrush}" BorderBrush="{ThemeResource BorderSoftBrush}" BorderThickness="0,0,0,1" ColumnSpacing="9">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"><Border Style="{StaticResource PillStyle}"><TextBlock Text="ALL SOURCES" FontSize="9" /></Border><TextBlock Text="Live output" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" /></StackPanel>
                                    <TextBox x:Name="LogSearchBox" Grid.Column="1" PlaceholderText="Search logs" MaxWidth="440" HorizontalAlignment="Stretch" TextChanged="LogSearchBox_TextChanged" />
                                    <Button Grid.Column="2" Content="Refresh" Click="RefreshLogs_Click" />
                                </Grid>
                                <ScrollViewer Grid.Row="1" HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto">
                                    <TextBlock x:Name="FullLog" Margin="17" Text="Logs appear here after the backend starts." Foreground="#FFB8C5C1" FontFamily="Cascadia Code, Consolas" FontSize="11" IsTextSelectionEnabled="True" TextWrapping="NoWrap" />
                                </ScrollViewer>
                                <Grid Grid.Row="2" Padding="13,0" Background="{ThemeResource SurfaceBrush}"><TextBlock x:Name="LogStatusText" Text="Waiting for events" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" /><StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Right" VerticalAlignment="Center"><Ellipse Width="6" Height="6" Fill="{ThemeResource SuccessBrush}" /><TextBlock Text="Following live output" Foreground="{ThemeResource AccentBrush}" FontSize="9" /></StackPanel></Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <ScrollViewer x:Name="EnginePage" Visibility="Collapsed">
                        <StackPanel Padding="34,30,34,60" Spacing="15" MaxWidth="1200" HorizontalAlignment="Stretch">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="5"><TextBlock Text="RUNTIME" Style="{StaticResource EyebrowStyle}" /><TextBlock Text="Engine" Style="{StaticResource PageTitleStyle}" /><TextBlock Text="Installed NInfer runtime, hardware compatibility and lifecycle." Style="{StaticResource MutedStyle}" /></StackPanel>
                                <Button Grid.Column="1" Content="Check for updates" Click="CheckUpdate_Click" VerticalAlignment="Bottom" />
                                <Button x:Name="EnginePagePrimaryButton" Grid.Column="2" Content="Load model" Click="EnginePrimary_Click" Style="{StaticResource ManagerPrimaryButtonStyle}" VerticalAlignment="Bottom" />
                            </Grid>
                            <Border Style="{StaticResource CardStyle}" Padding="24">
                                <Grid ColumnSpacing="17">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="62" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Border Width="58" Height="58" CornerRadius="17" Background="{ThemeResource AccentBrush}"><TextBlock Text="N" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FF071410" FontSize="24" FontWeight="Bold" /></Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4"><Border Style="{StaticResource PillStyle}" HorizontalAlignment="Left"><TextBlock Text="INSTALLED" FontSize="9" /></Border><TextBlock Text="NInferEZ Engine" Style="{StaticResource SectionTitleStyle}" /><TextBlock x:Name="EngineCompatibilityText" Text="NInfer All compatible · Windows x64" Style="{StaticResource CaptionStyle}" /><StackPanel x:Name="EnginePublisherSignature" Orientation="Horizontal" Spacing="6"><TextBlock Text="By" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" FontSize="8" /><Image x:Name="EnginePublisherLogo" Width="58" Height="24" Stretch="Uniform" AutomationProperties.Name="2beng2" /></StackPanel></StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"><TextBlock Text="APPLICATION VERSION" Style="{StaticResource CaptionStyle}" FontSize="9" /><TextBlock x:Name="AboutVersionText" Text="NInferEZ Manager" Style="{StaticResource MetricValueStyle}" FontSize="17" /><TextBlock x:Name="EngineStateText" Text="Checking engine" Foreground="{ThemeResource AccentBrush}" FontSize="10" HorizontalAlignment="Right" /></StackPanel>
                                </Grid>
                            </Border>
                            <Border x:Name="EngineOperationPanel" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <ProgressRing x:Name="EngineOperationRing" Width="34" Height="34" IsActive="True" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                        <TextBlock x:Name="EngineOperationPhaseText" Text="Preparing engine" Style="{StaticResource SectionTitleStyle}" />
                                        <TextBlock x:Name="EngineOperationMessageText" Text="Preparing the selected model." Style="{StaticResource MutedStyle}" TextWrapping="Wrap" />
                                        <TextBlock x:Name="EngineOperationElapsedText" Text="0:00 elapsed" Style="{StaticResource CaptionStyle}" />
                                    </StackPanel>
                                    <Button x:Name="CancelEngineOperationButton" Grid.Column="2" Content="Cancel" Click="CancelEngineOperation_Click" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <Grid ColumnSpacing="15">
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel Spacing="12"><TextBlock Text="INSTALLATION" Style="{StaticResource CaptionStyle}" FontSize="9" CharacterSpacing="100" /><Grid RowSpacing="12"><Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions><TextBlock Text="Engine state" Style="{StaticResource CaptionStyle}" /><TextBlock x:Name="EngineStateDetailText" Text="Unknown" HorizontalAlignment="Right" /><TextBlock Grid.Row="1" Text="Selected model" Style="{StaticResource CaptionStyle}" /><TextBlock x:Name="EngineModelText" Grid.Row="1" Text="None" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="310" /><TextBlock Grid.Row="2" Text="Detected GPU" Style="{StaticResource CaptionStyle}" /><TextBlock x:Name="EngineGpuText" Grid.Row="2" Text="Detecting" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="310" /><TextBlock Grid.Row="3" Text="Public API" Style="{StaticResource CaptionStyle}" /><TextBlock x:Name="EngineApiText" Grid.Row="3" Text="127.0.0.1:8173" HorizontalAlignment="Right" /></Grid><Button Content="Open setup assistant" Click="SetupWizard_Click" /></StackPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                                    <StackPanel Spacing="12"><TextBlock Text="CAPABILITIES" Style="{StaticResource CaptionStyle}" FontSize="9" CharacterSpacing="100" /><Grid ColumnSpacing="8" RowSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions><Border Style="{StaticResource PillStyle}"><TextBlock Text="✓ NInfer v3" /></Border><Border Grid.Column="1" Style="{StaticResource PillStyle}"><TextBlock Text="✓ DFlash2" /></Border><Border Grid.Row="1" Style="{StaticResource PillStyle}"><TextBlock Text="✓ MTP" /></Border><Border Grid.Row="1" Grid.Column="1" Style="{StaticResource PillStyle}"><TextBlock Text="✓ NVFP4" /></Border><Border Grid.Row="2" Style="{StaticResource PillStyle}"><TextBlock Text="✓ Vision" /></Border><Border Grid.Row="2" Grid.Column="1" Style="{StaticResource PillStyle}"><TextBlock Text="✓ Long context" /></Border></Grid><TextBlock Text="Capabilities shown here come from the installed engine package and selected model profile." Style="{StaticResource CaptionStyle}" /></StackPanel>
                                </Border>
                            </Grid>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="14">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="4"><TextBlock Text="ENGINE LIBRARY" Style="{StaticResource CaptionStyle}" FontSize="9" CharacterSpacing="100" /><TextBlock Text="Hardware-matched NInferEZ Engine packages" Style="{StaticResource SectionTitleStyle}" /><TextBlock x:Name="EngineRecommendationText" Text="Detecting the recommended package…" Style="{StaticResource MutedStyle}" TextWrapping="Wrap" /></StackPanel>
                                        <Button Grid.Column="1" Content="Refresh catalog" Click="RefreshEngines_Click" VerticalAlignment="Bottom" />
                                    </Grid>
                                    <ComboBox x:Name="EnginePackagePicker" Header="Available engine packages" SelectionChanged="EnginePackagePicker_SelectionChanged" HorizontalAlignment="Stretch" />
                                    <TextBlock x:Name="EnginePackageDetailText" Text="Select a package to see compatibility and installation state." Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Spacing="9"><Button x:Name="EnginePackageActionButton" Content="Install engine" Click="EnginePackageAction_Click" Style="{StaticResource ManagerPrimaryButtonStyle}" IsEnabled="False" /><Button x:Name="CancelEngineInstallButton" Content="Cancel download" Click="CancelEngineInstall_Click" Visibility="Collapsed" /></StackPanel>
                                    <StackPanel x:Name="EngineInstallProgressPanel" Spacing="6" Visibility="Collapsed"><ProgressBar x:Name="EngineInstallProgressBar" Minimum="0" Maximum="100" /><TextBlock x:Name="EngineInstallProgressText" Style="{StaticResource CaptionStyle}" /></StackPanel>
                                    <InfoBar x:Name="EngineLibraryInfo" IsOpen="False" IsClosable="True" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Padding="34,30,34,60" Spacing="15" MaxWidth="1420" HorizontalAlignment="Stretch">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="5"><TextBlock Text="PREFERENCES" Style="{StaticResource EyebrowStyle}" /><TextBlock Text="Settings" Style="{StaticResource PageTitleStyle}" /><TextBlock Text="Configure each model, the local API and application behavior from one workspace." Style="{StaticResource MutedStyle}" /></StackPanel>
                                <ComboBox x:Name="ThemePicker" Grid.Column="1" Width="120" SelectedIndex="0" SelectionChanged="ThemePicker_SelectionChanged" VerticalAlignment="Bottom"><ComboBoxItem Content="System" Tag="System" /><ComboBoxItem Content="Light" Tag="Light" /><ComboBoxItem Content="Dark" Tag="Dark" /></ComboBox>
                            </Grid>
                            <InfoBar x:Name="SettingsInfo" IsOpen="False" IsClosable="True" />

                            <Grid x:Name="SettingsWorkspace" ColumnSpacing="16" RowSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

                                <StackPanel x:Name="SettingsProfileColumn" Grid.Column="0" Spacing="15">
                                    <Border Style="{StaticResource CardStyle}" Background="{ThemeResource SurfaceAltBrush}">
                                        <StackPanel Spacing="9"><TextBlock Text="MODEL PROFILE" Style="{StaticResource CaptionStyle}" FontSize="9" CharacterSpacing="100" /><TextBlock Text="Choose the model whose runtime profile you want to edit." Style="{StaticResource MutedStyle}" /><ComboBox x:Name="ProfileModelPicker" ItemsSource="{x:Bind ProfileModels}" DisplayMemberPath="DisplayName" SelectionChanged="ProfileModel_SelectionChanged" HorizontalAlignment="Stretch" PlaceholderText="Choose an installed model" /></StackPanel>
                                    </Border>
                                    <Border x:Name="NoInstalledProfile" Style="{StaticResource CardStyle}" Visibility="Collapsed"><StackPanel Spacing="6"><TextBlock Text="No installed model yet" Style="{StaticResource SectionTitleStyle}" /><TextBlock Text="Install or link a model from the Models page. Its tested profile is selected automatically." Style="{StaticResource MutedStyle}" /></StackPanel></Border>

                                    <StackPanel x:Name="ProfileEditor" Spacing="15">
                                        <Border Style="{StaticResource CardStyle}">
                                            <StackPanel Spacing="15">
                                                <StackPanel Spacing="5"><TextBlock Text="Inference profile" Style="{StaticResource SectionTitleStyle}" /><TextBlock Text="Quality, context and acceleration settings for the selected model." Style="{StaticResource CaptionStyle}" /></StackPanel>
                                                <StackPanel Spacing="5"><TextBlock Text="API model name" Style="{StaticResource CaptionStyle}" /><TextBox x:Name="ModelApiNameBox" PlaceholderText="Keep the model's original API name" /><TextBlock Text="Clients use this value in the model field. Leave it unchanged to keep the default name." Style="{StaticResource CaptionStyle}" /></StackPanel>
                                                <Border Height="1" Background="{ThemeResource BorderSoftBrush}" />
                                                <CheckBox x:Name="AutoContextBox" Content="Automatically choose the highest safe context up to 512K" />
                                                <Grid ColumnSpacing="12" RowSpacing="12">
                                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                                    <StackPanel Spacing="5"><TextBlock Text="Maximum context" Style="{StaticResource CaptionStyle}" /><NumberBox x:Name="ContextBox" Minimum="1024" Maximum="524288" SpinButtonPlacementMode="Compact" /></StackPanel>
                                                    <StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="Prefill chunk" Style="{StaticResource CaptionStyle}" /><NumberBox x:Name="PrefillBox" Minimum="128" Maximum="65536" SpinButtonPlacementMode="Compact" /></StackPanel>
                                                    <StackPanel Grid.Row="1" Spacing="5"><TextBlock Text="KV precision" Style="{StaticResource CaptionStyle}" /><ComboBox x:Name="KvBox"><ComboBoxItem Content="BF16" /><ComboBoxItem Content="INT8" /><ComboBoxItem Content="FP8" /><ComboBoxItem Content="NVFP4" /><ComboBoxItem Content="K8V4" /><ComboBoxItem Content="RK8V4" /></ComboBox></StackPanel>
                                                    <StackPanel Grid.Row="1" Grid.Column="1" Spacing="5"><TextBlock Text="Speculative mode" Style="{StaticResource CaptionStyle}" /><ComboBox x:Name="SpecBox"><ComboBoxItem Content="Disabled" /><ComboBoxItem Content="MTP" /><ComboBoxItem Content="DFlash" /><ComboBoxItem Content="DFlash2" /></ComboBox></StackPanel>
                                                </Grid>
                                                <StackPanel x:Name="VisionCapabilityPanel" Spacing="4"><CheckBox x:Name="VisionBox" Content="Enable image input" /><TextBlock Text="Available only when both the model and engine support Vision." Style="{StaticResource CaptionStyle}" /></StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="9"><Button Content="Save profile" Click="SaveSettings_Click" Style="{StaticResource ManagerPrimaryButtonStyle}" /><Button Content="Restore tested defaults" Click="RestoreProfile_Click" /></StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <Expander Header="Advanced engine controls">
                                            <Border Style="{StaticResource CardStyle}" Margin="0,10,0,0"><StackPanel Spacing="14"><TextBlock Text="These values can affect stability, quality and memory use. Unsupported flags are not sent to the engine." Style="{StaticResource CaptionStyle}" /><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><StackPanel Spacing="5"><TextBlock Text="Draft tokens" Style="{StaticResource CaptionStyle}" /><NumberBox x:Name="DraftBox" Minimum="1" Maximum="15" SpinButtonPlacementMode="Compact" /></StackPanel><StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="Active requests" Style="{StaticResource CaptionStyle}" /><NumberBox x:Name="ConcurrencyBox" Minimum="1" Maximum="1" Value="1" IsEnabled="False" /></StackPanel></Grid><CheckBox x:Name="CudaBox" Content="CUDA graphs" /><CheckBox x:Name="PrefixBox" Content="Prefix reuse" /><StackPanel x:Name="AdvancedProfilePanel" Spacing="12" /><Button Content="Copy generated NInfer command" Click="CopyCommand_Click" HorizontalAlignment="Left" /></StackPanel></Border>
                                        </Expander>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel x:Name="SettingsApplicationColumn" Grid.Column="1" Spacing="15">
                                    <Border Style="{StaticResource CardStyle}">
                                        <StackPanel Spacing="14">
                                            <StackPanel Spacing="4"><TextBlock Text="Local API" Style="{StaticResource SectionTitleStyle}" /><TextBlock Text="Endpoint, access and browser-client settings." Style="{StaticResource CaptionStyle}" /></StackPanel>
                                            <StackPanel Spacing="5"><TextBlock Text="Public API port" Style="{StaticResource CaptionStyle}" /><NumberBox x:Name="PublicPortBox" Minimum="1024" Maximum="65535" SpinButtonPlacementMode="Compact" /></StackPanel>
                                            <CheckBox x:Name="LockPortBox" Content="Require this exact port" />
                                            <PasswordBox x:Name="ApiKeyBox" Header="Optional local API key" PlaceholderText="Empty means no authentication on localhost" />
                                            <CheckBox x:Name="CorsBox" Content="Allow browser clients (CORS)" />
                                            <Button Content="Apply API changes" Click="SaveRestartPort_Click" Style="{StaticResource ManagerPrimaryButtonStyle}" HorizontalAlignment="Left" />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource CardStyle}">
                                        <StackPanel Spacing="14">
                                            <StackPanel Spacing="4"><TextBlock Text="Memory and startup" Style="{StaticResource SectionTitleStyle}" /><TextBlock Text="Control VRAM release and Windows integration." Style="{StaticResource CaptionStyle}" /></StackPanel>
                                            <StackPanel Spacing="5"><TextBlock Text="Unload after idle minutes" Style="{StaticResource CaptionStyle}" /><NumberBox x:Name="IdleMinutesBox" Minimum="0.1" Maximum="1440" SmallChange="0.5" SpinButtonPlacementMode="Compact" ValueChanged="ApplicationNumberPreference_Changed" /></StackPanel>
                                            <CheckBox x:Name="AutoUnloadBox" Content="Automatically release VRAM when idle" Checked="ApplicationPreference_Changed" Unchecked="ApplicationPreference_Changed" />
                                            <Border Height="1" Background="{ThemeResource BorderSoftBrush}" />
                                            <CheckBox x:Name="StartWithWindowsBox" Content="Start with Windows" Checked="ApplicationPreference_Changed" Unchecked="ApplicationPreference_Changed" />
                                            <CheckBox x:Name="StartMinimizedBox" Content="Start in the notification area" Checked="ApplicationPreference_Changed" Unchecked="ApplicationPreference_Changed" />
                                            <CheckBox x:Name="CloseToTrayBox" Content="Close the window to the notification area" Checked="ApplicationPreference_Changed" Unchecked="ApplicationPreference_Changed" />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource CardStyle}">
                                        <StackPanel Spacing="12">
                                            <StackPanel Spacing="4"><TextBlock Text="Maintenance" Style="{StaticResource SectionTitleStyle}" /><TextBlock Text="Keep the application and model information current." Style="{StaticResource CaptionStyle}" /></StackPanel>
                                            <CheckBox x:Name="AutoUpdatesBox" Content="Check for application updates" Checked="ApplicationPreference_Changed" Unchecked="ApplicationPreference_Changed" />
                                            <CheckBox x:Name="AutoCatalogBox" Content="Check the model catalog" Checked="ApplicationPreference_Changed" Unchecked="ApplicationPreference_Changed" />
                                            <CheckBox x:Name="AutoEnginesBox" Content="Check the engine catalog" Checked="ApplicationPreference_Changed" Unchecked="ApplicationPreference_Changed" />
                                        </StackPanel>
                                    </Border>

                                    <Expander Header="Advanced application settings">
                                        <Border Style="{StaticResource CardStyle}" Margin="0,10,0,0"><StackPanel x:Name="AdvancedAppPanel" Spacing="12" /></Border>
                                    </Expander>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
    </Grid>
</Window>
