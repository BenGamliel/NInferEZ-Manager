                            </Border>
                            <Grid x:Name="EngineSupportGrid" ColumnSpacing="15" RowSpacing="15">
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Border x:Name="EngineInstallationCard" Style="{StaticResource CardStyle}">
                                    <StackPanel Spacing="12"><TextBlock Text="INSTALLATION" Style="{StaticResource CaptionStyle}" FontSize="9" CharacterSpacing="100" /><Grid RowSpacing="12"><Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions><TextBlock Text="Engine state" Style="{StaticResource CaptionStyle}" /><TextBlock x:Name="EngineStateDetailText" Text="Unknown" HorizontalAlignment="Right" /><TextBlock Grid.Row="1" Text="Selected model" Style="{StaticResource CaptionStyle}" /><TextBlock x:Name="EngineModelText" Grid.Row="1" Text="None" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="310" /><TextBlock Grid.Row="2" Text="Detected GPU" Style="{StaticResource CaptionStyle}" /><TextBlock x:Name="EngineGpuText" Grid.Row="2" Text="Detecting" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="310" /><TextBlock Grid.Row="3" Text="Public API" Style="{StaticResource CaptionStyle}" /><TextBlock x:Name="EngineApiText" Grid.Row="3" Text="127.0.0.1:8173" HorizontalAlignment="Right" /></Grid><Button Content="Open setup assistant" Click="SetupWizard_Click" /></StackPanel>
                                </Border>
                                <Border x:Name="EngineSupportCard" Grid.Column="1" Style="{StaticResource CardStyle}">
                                    <StackPanel Spacing="12"><TextBlock Text="MODEL &amp; HARDWARE SUPPORT" Style="{StaticResource CaptionStyle}" FontSize="11" CharacterSpacing="70" /><TextBlock x:Name="EngineModelSupportText" Text="Choose a model to view its reported capabilities." Style="{StaticResource CardTitleStyle}" TextWrapping="Wrap" /><TextBlock x:Name="EngineHardwareSupportText" Text="Select an engine matched to your GPU architecture." Style="{StaticResource MutedStyle}" /><TextBlock Text="A feature must be supported by the model artifact, engine build and GPU together. A successful build is not a real-device qualification." Style="{StaticResource CaptionStyle}" /></StackPanel>
                                </Border>
                            </Grid>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="14">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="4"><TextBlock Text="ENGINE LIBRARY" Style="{StaticResource CaptionStyle}" FontSize="9" CharacterSpacing="100" /><TextBlock Text="Hardware-matched NInferEZ Engine packages" Style="{StaticResource SectionTitleStyle}" /><TextBlock x:Name="EngineRecommendationText" Text="Detecting the recommended package…" Style="{StaticResource MutedStyle}" TextWrapping="Wrap" /></StackPanel>
                                        <Button Grid.Column="1" Content="Refresh catalog" Click="RefreshEngines_Click" VerticalAlignment="Bottom" />
                                    </Grid>
                                    <ComboBox x:Name="EnginePackagePicker" Header="Available engine packages" SelectionChanged="EnginePackagePicker_SelectionChanged" HorizontalAlignment="Stretch" />
                                    <TextBlock x:Name="EnginePackageDetailText" Text="Select a package to see compatibility and installation state." Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Spacing="9"><Button x:Name="EnginePackageActionButton" Content="Install engine" Click="EnginePackageAction_Click" Style="{StaticResource ManagerPrimaryButtonStyle}" IsEnabled="False" /><Button x:Name="CancelEngineInstallButton" Content="Cancel download" Click="CancelEngineInstall_Click" Visibility="Collapsed" /></StackPanel>
                                    <StackPanel x:Name="EngineInstallProgressPanel" Spacing="6" Visibility="Collapsed"><ProgressBar x:Name="EngineInstallProgressBar" Minimum="0" Maximum="100" /><TextBlock x:Name="EngineInstallProgressText" Style="{StaticResource CaptionStyle}" /></StackPanel>
                                    <InfoBar x:Name="EngineLibraryInfo" IsOpen="False" IsClosable="True" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Padding="34,30,34,60" Spacing="15" MaxWidth="1420" HorizontalAlignment="Stretch">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="5"><TextBlock Text="PREFERENCES" Style="{StaticResource EyebrowStyle}" /><TextBlock Text="Settings" Style="{StaticResource PageTitleStyle}" /><TextBlock Text="Configure each model, the local API and application behavior from one workspace." Style="{StaticResource MutedStyle}" /></StackPanel>
                                <ComboBox x:Name="ThemePicker" Grid.Column="1" Width="120" SelectedIndex="0" SelectionChanged="ThemePicker_SelectionChanged" VerticalAlignment="Bottom"><ComboBoxItem Content="System" Tag="System" /><ComboBoxItem Content="Light" Tag="Light" /><ComboBoxItem Content="Dark" Tag="Dark" /></ComboBox>
                            </Grid>
                            <InfoBar x:Name="SettingsInfo" IsOpen="False" IsClosable="True" />

                            <Grid x:Name="SettingsWorkspace" ColumnSpacing="16" RowSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

                                <StackPanel x:Name="SettingsProfileColumn" Grid.Column="0" Spacing="15">
                                    <Border Style="{StaticResource CardStyle}" Background="{ThemeResource SurfaceAltBrush}">
                                        <StackPanel Spacing="9"><TextBlock Text="MODEL PROFILE" Style="{StaticResource CaptionStyle}" FontSize="9" CharacterSpacing="100" /><TextBlock Text="Choose the model whose runtime profile you want to edit." Style="{StaticResource MutedStyle}" /><ComboBox x:Name="ProfileModelPicker" ItemsSource="{x:Bind ProfileModels}" DisplayMemberPath="DisplayName" SelectionChanged="ProfileModel_SelectionChanged" HorizontalAlignment="Stretch" PlaceholderText="Choose an installed model" /></StackPanel>
                                    </Border>
                                    <Border x:Name="NoInstalledProfile" Style="{StaticResource CardStyle}" Visibility="Collapsed"><StackPanel Spacing="6"><TextBlock Text="No installed model yet" Style="{StaticResource SectionTitleStyle}" /><TextBlock Text="Install or link a model from the Models page. Its tested profile is selected automatically." Style="{StaticResource MutedStyle}" /></StackPanel></Border>

                                    <StackPanel x:Name="ProfileEditor" Spacing="15">
                                        <Border Style="{StaticResource CardStyle}">
                                            <StackPanel Spacing="15">
                                                <StackPanel Spacing="5"><TextBlock Text="Inference profile" Style="{StaticResource SectionTitleStyle}" /><TextBlock Text="Quality, context and acceleration settings for the selected model." Style="{StaticResource CaptionStyle}" /></StackPanel>
                                                <Border Height="1" Background="{ThemeResource BorderSoftBrush}" />
                                                <CheckBox x:Name="ManageAdvancedBox" Content="Manage advanced settings for me" Checked="Management_Changed" Unchecked="Management_Changed" />
                                                <TextBlock x:Name="ManagementHint" Text="Recommended: dependent controls follow your choices. Turn off to restore your last manual advanced settings." Style="{StaticResource CaptionStyle}" />
                                                <TextBlock Text="Context and memory" Style="{StaticResource CardTitleStyle}" />
                                                <CheckBox x:Name="AutoContextBox" Content="Fit the context cache to available VRAM" Checked="BasicProfile_Changed" Unchecked="BasicProfile_Changed" />
                                                <TextBlock Text="Managed mode asks the engine to fit its cache after loading the weights. Your chosen KV quality stays unchanged. Manual mode uses the catalog estimate, which may not fit every GPU." Style="{StaticResource CaptionStyle}" />
                                                <Grid ColumnSpacing="12" RowSpacing="12">
                                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                                    <StackPanel Spacing="5"><TextBlock Text="Context limit (tokens)" Style="{StaticResource CaptionStyle}" /><NumberBox x:Name="ContextBox" Minimum="1024" Maximum="524288" SpinButtonPlacementMode="Compact" ValueChanged="BasicProfileNumber_Changed" /></StackPanel>
                                                    <StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="Context cache quality" Style="{StaticResource CaptionStyle}" /><ComboBox x:Name="KvBox" SelectionChanged="BasicProfileSelection_Changed"><ComboBoxItem Content="BF16" /><ComboBoxItem Content="INT8" /><ComboBoxItem Content="FP8" /><ComboBoxItem Content="NVFP4" /><ComboBoxItem Content="K8V4" /><ComboBoxItem Content="RK8V4" /></ComboBox></StackPanel>
                                                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Spacing="5"><TextBlock Text="Generation acceleration" Style="{StaticResource CaptionStyle}" /><ComboBox x:Name="SpecBox" DisplayMemberPath="Label" SelectionChanged="SpeculativeMode_Changed" AutomationProperties.Name="Generation acceleration" /><TextBlock x:Name="SpecCapabilityText" Style="{StaticResource CaptionStyle}" /></StackPanel>
                                                </Grid>
                                                <StackPanel x:Name="VisionCapabilityPanel" Spacing="4"><CheckBox x:Name="VisionBox" Content="Enable image input" Checked="BasicProfile_Changed" Unchecked="BasicProfile_Changed" /><TextBlock Text="Available only when both the model and engine support Vision." Style="{StaticResource CaptionStyle}" /></StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="9"><Button Content="Save profile" Click="SaveSettings_Click" Style="{StaticResource ManagerPrimaryButtonStyle}" /><Button Content="Restore recommended defaults" Click="RestoreProfile_Click" /></StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <Expander Header="Advanced engine controls">
                                            <Border Style="{StaticResource CardStyle}" Margin="0,10,0,0"><StackPanel Spacing="14"><TextBlock Text="Managed controls are read-only. Turn off 'Manage advanced settings for me' to restore and edit your manual setup. Grey controls do not apply to the current selection. Hover over ? for a short explanation. Save profile after editing." Style="{StaticResource CaptionStyle}" /><Grid ColumnSpacing="12" RowSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions><StackPanel x:Name="DraftControlsPanel" Spacing="5"><TextBlock Text="Draft tokens" Style="{StaticResource CaptionStyle}" /><NumberBox x:Name="DraftBox" Minimum="1" Maximum="15" SpinButtonPlacementMode="Compact" /></StackPanel><StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="Active requests" Style="{StaticResource CaptionStyle}" /><NumberBox x:Name="ConcurrencyBox" Minimum="1" Maximum="1" Value="1" IsEnabled="False" /></StackPanel><StackPanel Grid.Row="1" Grid.ColumnSpan="2" Spacing="5"><TextBlock Text="Prompt processing batch" Style="{StaticResource CaptionStyle}" /><NumberBox x:Name="PrefillBox" Minimum="128" Maximum="65536" SpinButtonPlacementMode="Compact" /></StackPanel></Grid><CheckBox x:Name="CudaBox" Content="CUDA graphs" /><CheckBox x:Name="PrefixBox" Content="Reuse previous prompt prefixes" /><StackPanel x:Name="AdvancedProfilePanel" Spacing="12" /><Button Content="Save profile" Click="SaveSettings_Click" Style="{StaticResource ManagerPrimaryButtonStyle}" HorizontalAlignment="Left" /><Button Content="Copy saved default model launch command" Click="CopyCommand_Click" HorizontalAlignment="Left" /></StackPanel></Border>
                                        </Expander>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel x:Name="SettingsApplicationColumn" Grid.Column="1" Spacing="15">
                                    <Border Style="{StaticResource CardStyle}">
                                        <StackPanel Spacing="14">
                                            <StackPanel Spacing="4"><TextBlock Text="Local API" Style="{StaticResource SectionTitleStyle}" /><TextBlock Text="Endpoint, access and browser-client settings." Style="{StaticResource CaptionStyle}" /></StackPanel>
                                            <StackPanel Spacing="5"><TextBlock Text="Public API port" Style="{StaticResource CaptionStyle}" /><NumberBox x:Name="PublicPortBox" Minimum="1024" Maximum="65535" SpinButtonPlacementMode="Compact" /></StackPanel>
                                            <CheckBox x:Name="LockPortBox" Content="Require this exact port" />
                                            <PasswordBox x:Name="ApiKeyBox" Header="Optional local API key" PlaceholderText="Empty means no authentication on localhost" />
                                            <CheckBox x:Name="CorsBox" Content="Allow browser clients (CORS)" />
                                            <CheckBox x:Name="LocalNetworkBox" Content="Allow access from the local network" />
                                            <TextBlock Text="Off by default. Requires an API key and listens on all interfaces, including VPN. Firewall and Tailscale rules are not changed automatically." Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                                            <Button Content="Apply API changes" Click="SaveRestartPort_Click" Style="{StaticResource ManagerPrimaryButtonStyle}" HorizontalAlignment="Left" />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource CardStyle}">
                                        <StackPanel Spacing="14">
                                            <StackPanel Spacing="4"><TextBlock Text="Memory and startup" Style="{StaticResource SectionTitleStyle}" /><TextBlock Text="Control VRAM release and Windows integration." Style="{StaticResource CaptionStyle}" /></StackPanel>
                                            <ComboBox x:Name="MemoryPolicyPicker" Header="Release model memory" SelectionChanged="MemoryPolicy_Changed" HorizontalAlignment="Stretch"><ComboBoxItem Content="After idle time" /><ComboBoxItem Content="After every request" /><ComboBoxItem Content="Keep the model loaded" /></ComboBox>
                                            <StackPanel x:Name="IdleTimePanel" Spacing="5"><TextBlock Text="Idle time (minutes)" Style="{StaticResource CaptionStyle}" /><NumberBox x:Name="IdleMinutesBox" Minimum="0.1" Maximum="1440" SmallChange="0.5" SpinButtonPlacementMode="Compact" ValueChanged="ApplicationNumberPreference_Changed" /></StackPanel>
                                            <TextBlock Text="After every request maximizes free VRAM, but the next request must cold-load the model again. The default is three idle minutes." Style="{StaticResource CaptionStyle}" />
                                            <Border Height="1" Background="{ThemeResource BorderSoftBrush}" />
                                            <CheckBox x:Name="StartWithWindowsBox" Content="Start with Windows" Checked="ApplicationPreference_Changed" Unchecked="ApplicationPreference_Changed" />
                                            <CheckBox x:Name="StartMinimizedBox" Content="Start in the notification area" Checked="ApplicationPreference_Changed" Unchecked="ApplicationPreference_Changed" />
                                            <CheckBox x:Name="CloseToTrayBox" Content="Close the window to the notification area" Checked="ApplicationPreference_Changed" Unchecked="ApplicationPreference_Changed" />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource CardStyle}">
                                        <StackPanel Spacing="12">
                                            <StackPanel Spacing="4"><TextBlock Text="Maintenance" Style="{StaticResource SectionTitleStyle}" /><TextBlock Text="Keep the application and model information current." Style="{StaticResource CaptionStyle}" /></StackPanel>
                                            <CheckBox x:Name="AutoUpdatesBox" Content="Check for application updates" Checked="ApplicationPreference_Changed" Unchecked="ApplicationPreference_Changed" />
                                            <CheckBox x:Name="AutoCatalogBox" Content="Check the model catalog" Checked="ApplicationPreference_Changed" Unchecked="ApplicationPreference_Changed" />
                                            <CheckBox x:Name="AutoEnginesBox" Content="Check the engine catalog" Checked="ApplicationPreference_Changed" Unchecked="ApplicationPreference_Changed" />
                                        </StackPanel>
                                    </Border>

                                    <Expander Header="Advanced application settings">
                                        <Border Style="{StaticResource CardStyle}" Margin="0,10,0,0"><StackPanel x:Name="AdvancedAppPanel" Spacing="12" /></Border>
                                    </Expander>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
    </Grid>
</Window>
